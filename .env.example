# Valores públicos del cliente web. Copiar a .env.local y completar localmente.
# Client ID *Web* de Google: el mismo que usa el backend en GOOGLE_CLIENT_ID. En Google Cloud Console
# debe tener http://localhost:3000 (y la URL del sitio desplegado) como "Orígenes de JavaScript autorizados".
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
# Login, registro de empresa y roles (/auth/*, /companies/*). Déjala VACÍA para pasar por el proxy de Next
# (usa BACKEND_URL y evita CORS, recomendado en local). Si la defines, el navegador llama directo a esa URL
# y el backend debe permitir el origen del sitio (CORS).
NEXT_PUBLIC_AGENT_BACKEND_URL=
# true muestra el acceso con correo y contraseña (POST /auth/login y /auth/register). El backend también
# debe tener AUTH_PASSWORD_ENABLED=true. Reiniciar dev / reconstruir el sitio al cambiar este valor.
NEXT_PUBLIC_PASSWORD_LOGIN_ENABLED=false
# true solo para presentar el fixture local en el directorio del panel.
# Reiniciar dev / reconstruir el sitio al cambiar este valor.
NEXT_PUBLIC_DEMO_PANEL_STANDS=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origen de datos del módulo /admin y del panel. Usa "http" cuando el backend esté desplegado.
NEXT_PUBLIC_API_MODE=mock
# UUID del evento activo en el backend para el directorio HTTP de stands.
NEXT_PUBLIC_FIPAZ_EVENT_ID=
# URL base del backend (solo servidor). En Vercel se configura como variable de entorno
# de Production y Preview cuando corresponda; nunca pongas aquí secretos del backend.
# El proxy /api/v1 funciona también para login de empresa, stands y las llamadas del panel.
BACKEND_URL=

# Formulario de contacto: URL de la aplicación web de Google Apps Script (ver docs/contact-form-apps-script.md).
# Opcional: la URL vigente ya viene en el código (ContactSection.tsx). Definirla aquí la reemplaza.
NEXT_PUBLIC_CONTACT_ENDPOINT=
