# ==============================================================================
# ExpoVia (frontend) — variables de entorno
# Copia este archivo a `.env.local` y ajusta los valores. Reinicia `next dev`
# después de cambiarlas: las NEXT_PUBLIC_* se incrustan al compilar.
# ==============================================================================

# Origen de datos del módulo /admin:
#   mock (por defecto) -> datos simulados, no requiere backend
#   http               -> llama al backend (fexpo-backend)
NEXT_PUBLIC_API_MODE=mock

# URL del backend. Sirve para dos cosas:
#   1) el proxy de Next reenvía /api/v1/* a este destino (el backend no habilita CORS,
#      así que el navegador no puede llamarlo directo);
#   2) las páginas de servidor (p. ej. el nombre del stand) lo consultan directamente.
# Si el backend corre en el puerto 3000 (su valor por defecto), inicia el frontend en
# otro puerto:  pnpm dev -p 3001
BACKEND_URL=http://localhost:3000

# Opcional. Solo si el backend habilitara CORS y quisieras que el navegador lo llame sin
# pasar por el proxy. Por defecto: /api/v1 (mismo origen, vía proxy).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
