# Valores públicos del cliente web. Copiar a .env.local y completar localmente.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
# Compatibilidad local: si BACKEND_URL está vacío, sirve como destino del proxy.
NEXT_PUBLIC_AGENT_BACKEND_URL=
# true solo para presentar el fixture local en el directorio del panel.
# Reiniciar dev / reconstruir el sitio al cambiar este valor.
NEXT_PUBLIC_DEMO_PANEL_STANDS=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origen de datos del módulo /admin y del panel. Usa "http" cuando el backend esté desplegado.
NEXT_PUBLIC_API_MODE=mock
# UUID del evento activo en el backend para el directorio HTTP de stands.
NEXT_PUBLIC_FIPAZ_EVENT_ID=
# URL base del backend (solo servidor). En Vercel se configura como variable de entorno
# de Production y Preview cuando corresponda; nunca pongas aquí secretos del backend.
# El proxy /api/v1 funciona también para login de empresa, stands y las llamadas del panel.
BACKEND_URL=
